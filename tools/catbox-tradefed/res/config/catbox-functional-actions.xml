<configuration description="Complete Automotive Tests - Vehicle Action Tests.">
    <include name="catbox-common" />
    <include name="catbox-preparer" />
    <option name="test-tag" value="catbox" />
    <option name="plan" value="catbox-functional-actions" />

    <option name="apk-installer:test-file-name" value="AutomotiveSnippet.apk" />
    <option name="compatibility:reverse-exclude-filters" value="true" />
    <option name="device-info-collector:skip-device-info" value="true" />

    <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
        <option name="mobly-par-file-name" value="ActionsGears" />
        <option name="mobly-par-file-name" value="ActionsHvac" />
        <option name="mobly-test-timeout" value="300000" />
        <option name="mobly-std-log" value="true" />
        <option name="mobly-config-file-name" value="actions_config.yaml" />
    </test>
</configuration>
